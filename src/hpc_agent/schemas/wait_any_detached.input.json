{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jamesdchen/hpc-agent/schemas/wait_any_detached.input.json",
  "title": "wait-any-detached input spec",
  "description": "Which detached workers to watch as a set, and for how long.",
  "type": "object",
  "required": [
    "targets"
  ],
  "additionalProperties": false,
  "properties": {
    "targets": {
      "items": {
        "$ref": "#/$defs/DetachedTarget"
      },
      "maxItems": 128,
      "minItems": 1,
      "title": "Targets",
      "type": "array"
    },
    "timeout_sec": {
      "default": 7200.0,
      "exclusiveMinimum": 0,
      "maximum": 86400.0,
      "title": "Timeout Sec",
      "type": "number"
    },
    "poll_interval_sec": {
      "default": 2.0,
      "exclusiveMinimum": 0,
      "maximum": 60.0,
      "title": "Poll Interval Sec",
      "type": "number"
    }
  },
  "$defs": {
    "DetachedTarget": {
      "additionalProperties": false,
      "description": "One watched detached worker — the identity ``wait-detached`` takes singly.",
      "properties": {
        "run_id": {
          "pattern": "^[A-Za-z0-9._\\-]+$",
          "title": "Run Id",
          "type": "string"
        },
        "block": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block"
        }
      },
      "required": [
        "run_id"
      ],
      "title": "wait-any-detached target",
      "type": "object"
    }
  }
}
