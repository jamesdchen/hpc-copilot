{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jamesdchen/hpc-agent/schemas/discover.output.json",
  "title": "discover output data",
  "type": "object",
  "required": [
    "kind"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "enum": [
        "executors",
        "runs",
        "reducers"
      ],
      "title": "Kind",
      "type": "string"
    },
    "executors": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/_ExecutorEntry"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Executors"
    },
    "runs": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/_RunEntry"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Runs"
    },
    "reducers": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/_ReducerEntry"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reducers"
    }
  },
  "$defs": {
    "_ExecutorEntry": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "cli_framework": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cli Framework"
        },
        "has_main_guard": {
          "title": "Has Main Guard",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "path",
        "has_main_guard"
      ],
      "title": "_ExecutorEntry",
      "type": "object"
    },
    "_ReducerEntry": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "matches": {
          "items": {
            "type": "string"
          },
          "title": "Matches",
          "type": "array"
        },
        "docstring": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Docstring"
        }
      },
      "required": [
        "name",
        "path",
        "matches"
      ],
      "title": "_ReducerEntry",
      "type": "object"
    },
    "_RunEntry": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "gpu": {
          "title": "Gpu",
          "type": "boolean"
        },
        "run_signature_sha": {
          "title": "Run Signature Sha",
          "type": "string"
        },
        "flags": {
          "items": {
            "type": "string"
          },
          "title": "Flags",
          "type": "array"
        }
      },
      "required": [
        "name",
        "path",
        "gpu",
        "run_signature_sha",
        "flags"
      ],
      "title": "_RunEntry",
      "type": "object"
    }
  }
}
