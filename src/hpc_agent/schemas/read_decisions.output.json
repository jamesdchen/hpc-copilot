{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jamesdchen/hpc-agent/schemas/read_decisions.output.json",
  "title": "read-decisions output data",
  "description": "A scope's decision journal, oldest first.\n\nDigest mode (spec ``digest: true``) fills ``records_digest`` and leaves\n``records`` EMPTY; the default fills ``records`` and OMITS\n``records_digest`` entirely (the serializer drops the ``None`` — the\ndefault response stays byte-identical to the pre-digest wire shape).\n``count`` is the journal's record count in both modes.",
  "type": "object",
  "required": [
    "path",
    "records",
    "count"
  ],
  "additionalProperties": false,
  "properties": {
    "path": {
      "title": "Path",
      "type": "string"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/DecisionRecord"
      },
      "title": "Records",
      "type": "array"
    },
    "count": {
      "minimum": 0,
      "title": "Count",
      "type": "integer"
    },
    "records_digest": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/DecisionRecordDigest"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Records Digest"
    }
  },
  "$defs": {
    "DecisionRecord": {
      "additionalProperties": true,
      "description": "One persisted decision-journal line, as read back from disk.\n\n``extra=\"allow\"`` so an additive schema bump (a new field written by a\nnewer writer) does not break an older reader — the same forward-compat\nposture ``load-context``'s nested rows take against evolving sidecar\nschemas.",
      "properties": {
        "schema_version": {
          "title": "Schema Version",
          "type": "integer"
        },
        "ts": {
          "title": "Ts",
          "type": "string"
        },
        "scope_kind": {
          "enum": [
            "run",
            "campaign",
            "scope",
            "notebook",
            "registration",
            "pack",
            "conclusion",
            "challenge"
          ],
          "title": "Scope Kind",
          "type": "string"
        },
        "scope_id": {
          "pattern": "^[A-Za-z0-9._\\-]+$",
          "title": "Scope Id",
          "type": "string"
        },
        "block": {
          "title": "Block",
          "type": "string"
        },
        "response": {
          "title": "Response",
          "type": "string"
        },
        "evidence_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "additionalProperties": true,
              "type": "object"
            }
          ],
          "default": "",
          "title": "Evidence Digest"
        },
        "proposal": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {},
              "type": "array"
            },
            {
              "additionalProperties": true,
              "type": "object"
            }
          ],
          "default": "",
          "title": "Proposal"
        },
        "resolved": {
          "additionalProperties": true,
          "title": "Resolved",
          "type": "object"
        },
        "provenance": {
          "additionalProperties": true,
          "title": "Provenance",
          "type": "object"
        },
        "attestor_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attestor Id"
        }
      },
      "required": [
        "schema_version",
        "ts",
        "scope_kind",
        "scope_id",
        "block",
        "response"
      ],
      "title": "decision journal record",
      "type": "object"
    },
    "DecisionRecordDigest": {
      "additionalProperties": false,
      "description": "One record's identity/ordering metadata — everything the preflight scan\nreads, none of the prose. ``response_sha12`` fingerprints the response text\n(verifiable against the full record); ``resolved_keys`` names the resolved\nmapping's keys without its values.",
      "properties": {
        "ts": {
          "title": "Ts",
          "type": "string"
        },
        "block": {
          "title": "Block",
          "type": "string"
        },
        "response_sha12": {
          "title": "Response Sha12",
          "type": "string"
        },
        "response_chars": {
          "minimum": 0,
          "title": "Response Chars",
          "type": "integer"
        },
        "resolved_keys": {
          "items": {
            "type": "string"
          },
          "title": "Resolved Keys",
          "type": "array"
        },
        "attestor_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attestor Id"
        }
      },
      "required": [
        "ts",
        "block",
        "response_sha12",
        "response_chars",
        "resolved_keys"
      ],
      "title": "read-decisions record digest",
      "type": "object"
    }
  }
}
